{
  "expo": {
    "name": "DrivePro",
    "slug": "drivepro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06070d",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06070d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.igorvuta.drivepro",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DrivePro uses your location to show you on the map, find nearby drivers and track rides."
      }
    },
    "android": {
      "package": "com.igorvuta.drivepro",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06070d"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
