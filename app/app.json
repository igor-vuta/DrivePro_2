{
  "expo": {
    "name": "DrivePro",
    "slug": "drivepro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFEFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.igorvuta.drivepro",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DrivePro uses your location to show you on the map, find nearby drivers and track rides."
      }
    },
    "android": {
      "package": "com.igorvuta.drivepro",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFEFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFEFF"
        }
      ]
    ]
  }
}
